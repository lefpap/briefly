# Select the News Brief generation model in src/main/resources/application.yaml:
# app.ai.agents.brief-generation.model: provider/model
# Providers: openai | anthropic | google-genai | ollama

# Fill credentials only for providers you use. Local Ollama needs no key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Settings for GNews API.
GNEWS_API_KEY=
